{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "browser-mcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@agent360/browser-mcp@latest"
        ]
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "protocol": "auto",
        "pool": true
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/readonly",
        "oauth": {
          "client_id": "Ov23liDCg7RHx7R6V6NZ",
          "client_secret": "{file:~/.local/share/opencode/private/github-mcp-client-secret}",
          "redirect_uri": "http://127.0.0.1:19877/callback"
        },
        "protocol": "auto",
        "pool": true
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "protocol": "auto",
        "pool": true
      },
      "google-workspace": {
        "type": "local",
        "command": [
          "node",
          "{env:HOME}/.config/opencode/scripts/google-workspace.mjs"
        ],
        "cwd": "{env:HOME}",
        "timeout": {
          "startup": 120000,
          "catalog": 60000
        }
      }
    }
  },
  "providers": {
    "custom-glm": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "GLM 官方",
      "settings": {
        "baseURL": "https://open.bigmodel.cn/api/coding/paas/v4",
        "apiKey": "{file:~/.secrets/glm.key}"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "glm-5.3-flash": {
          "name": "GLM-5.3 Flash"
        }
      }
    }
  },
  "formatter": true,
  "plugins": [
    "-opencode.provider.openai-context-caps"
  ],
  "model": "openai/gpt-6-astra-fast",
  "agents": {
    "title": {
      "model": "openai/gpt-6-astra-fast"
    }
  },
  "default_agent": "build"
}
